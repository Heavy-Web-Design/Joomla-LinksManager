<?xml version="1.0"?>
<ruleset name="ModernJoomlaComponentStandard">
    <description>Strict PSR-12 rule definitions for modern Joomla development.</description>

    <!-- Enforce PSR-12 strictly -->
    <rule ref="PSR12"/>

    <!-- Set target directories to check automatically -->
    <file>admin/src</file>
    <file>site/src</file>

    <!-- Show progress flags and colors in CLI runs -->
    <arg value="sp"/>
    <arg name="colors"/>
</ruleset>