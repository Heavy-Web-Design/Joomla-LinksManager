<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">

	<name>COM_HWDLINKS</name><!-- This is a translatable string. Translate on sys language file -->
	<!-- The following elements are optional and free of formatting constraints -->
	<creationDate>July, 2026</creationDate>
	<author>Heavy Web Design</author>
	<authorEmail>juanpablo@heavywebdesign.com</authorEmail>
	<authorUrl>http://www.heavywebdesign.com</authorUrl>
	<copyright>Copyright Info</copyright>
	<license>License Info</license>
	<!--  The version string is recorded in the components table -->
	<version>0.3.0</version>
	<!-- The description is optional and defaults to the name -->
	<description>COM_HWDLINKS_DESCRIPTION</description>

	<element>com_hwdlinks</element>

	<namespace path="src">HWD\Component\HwdLinks</namespace>

	<!-- Runs on install/uninstall/update -->
	<scriptfile>script.php</scriptfile>

	<install> Runs on install
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.sql</file>
		</sql>
	</install>
	<uninstall> Runs on uninstall
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.sql</file>
		</sql>
	</uninstall>

	<update> Runs on update; New since J2.5
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<!-- Site Main File Copy Section -->
	<!-- Note the folder attribute: This attribute describes the folder
		to copy FROM in the package to install therefore files copied
		in this section are copied from /site/ in the package -->
	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<!-- Use this to root/language files -->
	<!--<languages folder="site/language">
		<language tag="en-GB">en-GB/en-GB.com_hwdlinks.ini</language>
	</languages>-->

	<!--<media destination="com_helloworld" folder="media">
		<filename>index.html</filename>
		<folder>images</folder>
	</media>-->

	<administration>
		<files folder="admin">
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<file>access.xml</file>
			<file>script.php</file>
		</files>
		<!-- Use this to root/administrator/language files -->
		<languages folder="admin/language">
			<language tag="en-GB">en-GB/en-GB.com_hwdlinks.ini</language>
			<language tag="en-GB">en-GB/en-GB.com_hwdlinks.sys.ini</language>
		</languages>
		<!-- Administration Menu Section -->
		<menu link="option=com_hwdlinks">COM_HWDLINKS</menu>
        <!--<submenu>
            <menu link="option=com_hwdlinks&amp;view=links">COM_HWDLINKS_VIEW_DEFAULT_TITLE</menu>
        </submenu>-->
	</administration>

</extension>
